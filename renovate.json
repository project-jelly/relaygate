{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["cargo"],
  "branchPrefix": "renovate-actions/",
  "timezone": "Asia/Seoul",
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 0,
  "ignorePaths": ["tests/package-consumer/**"],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Cargo patch updates"
    },
    {
      "matchPackageNames": ["/^relaygate-/"],
      "enabled": false
    }
  ]
}
