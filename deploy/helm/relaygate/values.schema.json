{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clusterDomain",
    "authorization",
    "tls",
    "serviceAccount",
    "podSecurityContext",
    "containerSecurityContext",
    "metrics",
    "gateway",
    "routeTable"
  ],
  "properties": {
    "clusterDomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingConfigMap",
        "configKey"
      ],
      "properties": {
        "existingConfigMap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "configKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[-._a-zA-Z0-9]+$"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "internal"],
      "properties": {
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "trustMode",
            "serverName"
          ],
          "properties": {
            "existingSecret": { "$ref": "#/definitions/dnsSubdomain" },
            "trustMode": {
              "type": "string",
              "enum": ["customCa", "webPkiRoots"]
            },
            "serverName": { "$ref": "#/definitions/dnsSubdomain" }
          }
        },
        "internal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "trustSecret", "gatewaySecret", "routeTableSecret", "gatewayServerName", "routeTableServerName"],
          "properties": {
            "mode": { "type": "string", "enum": ["mtls", "plaintext"] },
            "trustSecret": { "$ref": "#/definitions/dnsSubdomain" },
            "gatewaySecret": { "$ref": "#/definitions/dnsSubdomain" },
            "routeTableSecret": { "$ref": "#/definitions/dnsSubdomain" },
            "gatewayServerName": { "$ref": "#/definitions/dnsSubdomain" },
            "routeTableServerName": { "$ref": "#/definitions/dnsSubdomain" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "annotations", "name"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "intervalMs", "gatewayPort", "routeTablePort"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 1
        },
        "gatewayPort": {
          "$ref": "#/definitions/port"
        },
        "routeTablePort": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "sdkPort",
        "peerPort",
        "service",
        "log",
        "logFormat",
        "podAnnotations",
        "podLabels",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "topologySpreadConstraints",
        "drainTimeoutMs",
        "terminationGracePeriodSeconds",
        "extraEnv"
      ],
      "properties": {
        "annotations": { "$ref": "#/definitions/stringMap" },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "sdkPort": {
          "$ref": "#/definitions/port"
        },
        "peerPort": {
          "$ref": "#/definitions/port"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "port",
            "annotations",
            "loadBalancerClass",
            "externalTrafficPolicy"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "LoadBalancer"]
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "loadBalancerClass": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": ["Cluster", "Local"]
            }
          }
        },
        "log": {
          "type": "string",
          "minLength": 1
        },
        "logFormat": {
          "type": "string",
          "enum": ["text", "json"]
        },
        "statsIntervalMs": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "drainTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        }
      }
    },
    "routeTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shardCount",
        "image",
        "port",
        "leaseTtlMs",
        "log",
        "logFormat",
        "podAnnotations",
        "podLabels",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "topologySpreadConstraints",
        "terminationGracePeriodSeconds",
        "extraEnv"
      ],
      "properties": {
        "annotations": { "$ref": "#/definitions/stringMap" },
        "shardCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "leaseTtlMs": {
          "type": "integer",
          "minimum": 1
        },
        "log": {
          "type": "string",
          "minLength": 1
        },
        "logFormat": {
          "type": "string",
          "enum": ["text", "json"]
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        }
      }
    }
  },
  "definitions": {
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:(?:(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9])(?:\\.(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]))*|\\[(?:[A-Fa-f0-9:]+)\\])(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|[-]+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|[-]+)[a-z0-9]+)*)*$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}(@sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
